{
  "expo": {
    "name": "contractor-app",
    "slug": "contractor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contractorapp",
    "userInterfaceStyle": "light",
    "description": "אפליקציה לניהול דוחות שטח ומסמכים עבור קבלנים וייעוצים מקצועיים",
    "privacy": "https://github.com/rachelelyashiv/contractor-app/blob/main/PRIVACY_POLICY.md",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTabletMode": true,
      "infoPlist": {
        "NSCameraUsageDescription": "האפליקציה צריכה גישה למצלמה כדי לצלם תמונות שטח.",
        "NSPhotoLibraryUsageDescription": "האפליקציה צריכה גישה לתמונות כדי להעלות תמונות שטח ומסמכים."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.rachelelyashiv.contractorapp",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה צריכה גישה לתמונות כדי להעלות תמונות שטח ומסמכים.",
          "cameraPermission": "האפליקציה צריכה גישה למצלמה כדי לצלם תמונות שטח."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f0b3019-052d-4eb1-9a08-6ab4a776e349"
      }
    }
  }
}
